{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "Rect": {
            "type": "array",
            "items": {
                "type": "integer"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "Recognition result box as [x, y, w, h]."
        },
        "ExampleRecognitionParam": {
            "type": "object",
            "properties": {
                "node": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Existing recognition node to reuse through context.run_recognition()."
                },
                "template_node": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Alias of node, kept for examples that name reusable recognition nodes this way."
                },
                "box": {
                    "$ref": "#/$defs/Rect"
                },
                "detail": {
                    "type": "object",
                    "description": "Extra detail object returned with CustomRecognition.AnalyzeResult."
                }
            },
            "additionalProperties": true
        },
        "NumberThresholdParam": {
            "type": "object",
            "description": "Reads a number from a reused OCR node and hits when the comparison against threshold is true.",
            "properties": {
                "ocr_node": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Existing OCR node to run through context.run_recognition(); its roi/only_rec/expected apply."
                },
                "threshold": {
                    "type": [
                        "number",
                        "string"
                    ],
                    "description": "Value to compare with the number read from ocr_node. Numeric strings are accepted too."
                },
                "comparison": {
                    "type": "string",
                    "enum": [
                        ">",
                        ">=",
                        "<",
                        "<=",
                        "==",
                        "!="
                    ],
                    "default": ">",
                    "description": "Comparison operator applied as `value <comparison> threshold`."
                },
                "pattern": {
                    "type": "string",
                    "minLength": 1,
                    "default": "\\d+(?:\\.\\d+)?",
                    "description": "Regex used to extract numbers from the OCR text. Matches that are not numbers are ignored."
                },
                "index": {
                    "type": "integer",
                    "default": 0,
                    "description": "Which extracted number to test. Negative values are resolved Python-style."
                }
            },
            "required": [
                "ocr_node",
                "threshold"
            ],
            "additionalProperties": false
        }
    },
    "type": "object",
    "properties": {
        "custom_recognition": {
            "type": "string",
            "description": "Registered custom recognition name."
        },
        "custom_recognition_param": {
            "description": "Parameters passed to the registered custom recognition."
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "custom_recognition": {
                        "const": "ExampleRecognition"
                    }
                },
                "required": [
                    "custom_recognition"
                ]
            },
            "then": {
                "properties": {
                    "custom_recognition_param": {
                        "$ref": "#/$defs/ExampleRecognitionParam"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "custom_recognition": {
                        "const": "NumberThreshold"
                    }
                },
                "required": [
                    "custom_recognition"
                ]
            },
            "then": {
                "properties": {
                    "custom_recognition_param": {
                        "$ref": "#/$defs/NumberThresholdParam"
                    }
                }
            }
        }
    ]
}
