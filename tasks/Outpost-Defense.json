{
    "task": [
        {
            "name": "OutpostDefense",
            "label": "前哨防御",
            "entry": "OutpostDefense.Entry",
            "description": "读取「前哨防御」界面上的百分比数字，超过阈值后点击数字区域；随后处理「一举歼灭」（只有从这里进入才会出现该按钮）：有红点才点它，未启用则改为点击「获取奖励」→ 点掉确认框 → 关窗。",
            "option": [
                "OutpostDefenseThreshold",
                "AnnihilateEnabled"
            ]
        }
    ],
    "option": {
        "OutpostDefenseThreshold": {
            "type": "input",
            "label": "前哨防御触发阈值",
            "description": "识别到的百分比 **大于** 该数值时才点击。默认 50。",
            "inputs": [
                {
                    "name": "thresholdPercent",
                    "label": "阈值(%)",
                    "default": "50",
                    "pipeline_type": "int",
                    "verify": "^(?:[1-9]?\\d|100)$",
                    "pattern_msg": "请填写 0-100 之间的整数"
                }
            ],
            "pipeline_override": {
                "OutpostDefense.ClickOnThreshold": {
                    "custom_recognition_param": {
                        "ocr_node": "OutpostDefense.ReadPercent",
                        "threshold": "{thresholdPercent}",
                        "comparison": ">"
                    }
                }
            }
        },
        "AnnihilateEnabled": {
            "type": "switch",
            "label": "启用一举歼灭",
            "description": "启用：有红点则点击「一举歼灭」。不启用：不点「一举歼灭」。",
            "cases": [
                {
                    "name": "Yes",
                    "label": "启用"
                },
                {
                    "name": "No",
                    "label": "不启用",
                    "pipeline_override": {
                        "Annihilate.Entry": {
                            "next": [
                                "Annihilate.ClaimReward"
                            ]
                        }
                    }
                }
            ],
            "default_case": "Yes"
        }
    }
}
