{
    "interface_version": 2,
    "name": "mna",
    "label": "MNA",
    "version": "v0.0.1",
    "description": "MNA 小助手",
    "github": "https://github.com/YlovexLN/MNA",
    "mirrorchyan_multiplatform": true,
    "license": "MIT",
    "controller": [
        {
            "name": "Windows",
            "label": "PC 客户端",
            "type": "Win32",
            "display_short_side": 720,
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "胜利女神"
            }
        }
    ],
    "resource": [
        {
            "name": "base",
            "label": "通用资源",
            "path": [
                "./resource/base"
            ]
        }
    ],
    "import": [
        "./tasks/StartGame.json",
        "./tasks/Outpost-Defense.json",
        "./tasks/Annihilate.json"
    ],
    "agent": [
        {
            "child_exec": "uv",
            "child_args": [
                "run",
                "python",
                "agent/main.py"
            ]
        }
    ]
}
