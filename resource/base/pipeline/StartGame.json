{
    "StartGame.Entry": {
        "action": "DoNothing",
        "timeout": 60000,
        "next": [
            "StartGame.ClickStart"
        ]
    },
    "StartGame.ClickStart": {
        "recognition": "OCR",
        "expected": "点击开始",
        "action": "Click",
        "contact": 0,
        "post_delay": 1000,
        "timeout": 30000,
        // 公告弹窗要先关掉再继续：关它的整条子链跑完后，[JumpBack] 会回到本节点接着识别下一个候选，
        // 所以「按 ESC」只有在公告不存在时才会被尝试。
        "next": [
            "[JumpBack]StartGame.CloseAnnouncement",
            "StartGame.ClaimComebackReward",
            "StartGame.PressEsc"
        ]
    },
    "StartGame.CloseAnnouncement": {
        "recognition": "OCR",
        "roi": [
            604,
            54,
            82,
            44
        ],
        "expected": "公告",
        "action": "DoNothing",
        "timeout": 5000,
        // 这里不再挂 [JumpBack]：子链跑完就结束，由 ClickStart 那边的 [JumpBack] 负责回到主流程。
        "next": [
            "StartGame.ClickAnnouncementClose"
        ]
    },
    "StartGame.ClickAnnouncementClose": {
        "recognition": "TemplateMatch",
        "template": "Announcement-Close.png",
        "action": "Click",
        "contact": 0,
        "post_delay": 1000
        // next 为空：关掉公告这条子链到此结束，回到 ClickStart 继续（见那边的 [JumpBack]）。
    },
    "StartGame.ClaimComebackReward": {
        "recognition": "TemplateMatch",
        "roi": [
            457,
            601,
            372,
            71
        ],
        "template": "Comeback-Claim-All.png",
        "action": "DoNothing",
        "timeout": 20000,
        "next": [
            "ClaimReward.Confirm"
        ]
    },
    "StartGame.CloseComebackPopup": {
        "recognition": "TemplateMatch",
        "roi": [
            782,
            34,
            49,
            46
        ],
        "template": "Comeback-Close.png",
        "action": "Click",
        "contact": 0,
        "post_delay": 1000,
        "timeout": 10000,
        "next": [
            "StartGame.PressEsc"
        ]
    },

    // 进入游戏后的收尾：按 ESC 弹出系统菜单，以 ROI 内 OCR 出「通知」判定已正常进入游戏界面，
    // 再点击「确认」。后续任务从这里接管。
    // 这里的 27 是 VK_ESCAPE（虚拟按键码，ClickKey 只接受整数），作为兜底值；
    // 用户想换键可以用 interface.json 里的「系统菜单按键」配置项（那边写的是 ESC 这类可读名字，
    // 由 PI 的 hotkey 机制翻译成整数）。该配置项只能放 interface.json：hotkey 类型只在
    // interface.schema.json 中定义（tasks 目录用的 interface_import.schema.json 不支持），
    // 而且 interface.json 会被 tools/build-release.mjs 用 JSON.parse 读取，里面不能写注释。
    "StartGame.PressEsc": {
        "action": "ClickKey",
        "key": 27,
        "post_delay": 1000,
        "next": [
            "StartGame.CheckNotice"
        ]
    },
    "StartGame.CheckNotice": {
        "recognition": "OCR",
        "roi": [
            569,
            167,
            157,
            84
        ],
        "expected": "通知",
        "action": "DoNothing",
        "timeout": 30000,
        "next": [
            "StartGame.ClickNoticeConfirm"
        ]
    },
    "StartGame.ClickNoticeConfirm": {
        "recognition": "OCR",
        "expected": "取消",
        "action": "Click",
        "contact": 0,
        "post_delay": 1000
    }
}
